# Copy to .env (gitignored) for local live WebSocket integration tests.
# NEVER commit real tokens. Rotate any key that was pasted into chat or logs.

AI_BUILDER_TOKEN=replace-with-your-real-token
# Alternate name accepted by scripts/tests:
# VOICEFLOW_AI_BUILDER_TOKEN=replace-with-your-real-token
AI_BUILDER_SPACE_ENDPOINT=https://space.ai-builders.com/backend
# Optional overrides for GPT Live live-gate source fixtures. The live script
# normalizes these to PCM16 mono 24 kHz WAV under ignored .voiceflow/ storage.
# VOICEFLOW_MODEL_BENCHMARK_DIR=/absolute/path/to/model_benchmark
# VOICEFLOW_GPT_LIVE_SHORT_WAV=/absolute/path/to/short-audio.wav
# VOICEFLOW_GPT_LIVE_60S_WAV=/absolute/path/to/one-minute-audio.mp3
# VOICEFLOW_GPT_LIVE_5MIN_WAV=/absolute/path/to/five-minute-audio.mp3

# OpenCode live "send transcript" integration test (opt-in, OPENCODE_LIVE=1).
# Used by scripts/test_live_opencode.sh. NEVER commit real credentials.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=replace-with-your-real-password
